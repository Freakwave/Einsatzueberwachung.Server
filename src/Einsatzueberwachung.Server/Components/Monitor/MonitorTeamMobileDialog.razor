@if (IsOpen)
{
    <div class="modal-overlay">
        <button type="button" class="modal-overlay-dismiss" @onclick="OnClose" aria-label="Dialog schließen"></button>
        <div class="modal-modern modal-modern--md" @onclick:stopPropagation="true">
            <div class="modal-modern-header bg-success text-white">
                <h3 class="mb-0"><i class="bi bi-qr-code me-1"></i>Team-Mobile Anmelde-Code</h3>
                <button class="btn btn-sm btn-outline-light" @onclick="OnClose">X</button>
            </div>
            <div class="modal-modern-body text-center">
                @if (string.IsNullOrEmpty(FullUrl))
                {
                    <div class="alert alert-warning">
                        Es ist gerade kein Einsatz aktiv. Starte einen Einsatz, um einen Anmelde-Code zu generieren.
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-2">
                        Teams scannen diesen QR-Code mit dem Smartphone, um sich auf <strong>/team/login</strong> anzumelden.
                    </p>
                    <img src="@QrDataUrl" alt="QR-Code" class="monitor-qr-image" />
                    @if (!string.IsNullOrEmpty(ReadableCode))
                    {
                        @* Zum Vorlesen per Funk oder Abtippen auf /team/login, wenn ein Handy den QR-Code nicht scannt *@
                        <div class="monitor-team-code" aria-label="Anmelde-Code">@ReadableCode</div>
                        <div class="small text-muted">Anmelde-Code – auf <strong>/team/login</strong> eintippen</div>
                    }
                    <div class="mt-3">
                        <input type="text" class="form-control text-center" readonly value="@FullUrl" onclick="this.select()" />
                    </div>
                    <p class="small text-muted mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Der Code wird beim Einsatz-Ende automatisch ungültig.
                    </p>
                }
            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-outline-secondary" @onclick="OnClose">Schließen</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string FullUrl { get; set; } = string.Empty;
    [Parameter] public string QrDataUrl { get; set; } = string.Empty;
    [Parameter] public string ReadableCode { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
}
