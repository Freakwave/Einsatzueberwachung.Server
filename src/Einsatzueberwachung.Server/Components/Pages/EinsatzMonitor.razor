@* ===== Modals ===== *@

@if (_showCloseMissionModal)
{
    <div class="modal-overlay">
        <button type="button" class="modal-overlay-dismiss" @onclick="CloseCloseMissionModal" aria-label="Dialog schließen"></button>
        <div class="modal-modern modal-close-mission" @onclick:stopPropagation="true">
            <div class="modal-modern-header modal-close-mission-header">
                <h3 class="mb-0"><i class="bi bi-exclamation-octagon me-1"></i>Einsatz beenden und archivieren</h3>
                <button class="btn btn-sm btn-outline-light" @onclick="CloseCloseMissionModal" disabled="@_closingMission">X</button>
            </div>
            <div class="modal-modern-body">
                <div class="alert alert-warning py-2 mb-3">
                    Nach dem Beenden wird der Einsatz archiviert, ein PDF erzeugt und das System für den nächsten Einsatz vorbereitet.
                </div>

                @if (!string.IsNullOrWhiteSpace(_closeMissionModalError))
                {
                    <div class="alert alert-danger py-2">@_closeMissionModalError</div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-8">
                        <label class="form-label">Ergebnis</label>
                        <select class="form-select" @bind="_closeMissionResult">
                            <option value="">-- Bitte wählen --</option>
                            @foreach (var option in _closeMissionResultOptions)
                            {
                                <option value="@option">@ErgebnisText.Anzeige(option)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Ende-Zeit</label>
                        <input type="time" class="form-control" @bind="_closeMissionEndTime" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Bemerkungen</label>
                        <textarea class="form-control" rows="2" @bind="_closeMissionRemarks" placeholder="Zusatzinformationen zum Abschluss..."></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" @bind="_closeMissionIncludeTracks" />
                            <span class="form-check-label">
                                <i class="bi bi-geo-alt me-1"></i>GPS-Livetracking dem PDF hinzufügen
                                @if (_closeMissionTrackCount > 0)
                                {
                                    <span class="badge bg-info ms-1">@_closeMissionTrackCount Track(s)</span>
                                }
                                else
                                {
                                    <span class="text-muted ms-1">(keine Tracks vorhanden)</span>
                                }
                            </span>
                        </label>
                    </div>
                    <div class="col-12">
                        <label class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" @bind="_closeMissionIncludePunkte" disabled="@(_closeMissionPunktCount == 0)" />
                            <span class="form-check-label">
                                <i class="bi bi-pin-map me-1"></i>Kartenpunkte dem PDF hinzufügen
                                @if (_closeMissionPunktCount > 0)
                                {
                                    <span class="badge bg-info ms-1">@_closeMissionPunktCount Punkt(e)</span>
                                    <span class="text-muted ms-1">(werden dafür archiviert)</span>
                                }
                                else
                                {
                                    <span class="text-muted ms-1">(keine Punkte vorhanden)</span>
                                }
                            </span>
                        </label>
                    </div>
                    @if (_closeMissionIncludeTracks || _closeMissionIncludePunkte)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label">Karte im Bericht</label>
                            <select class="form-select" @bind="_closeMissionKartenart">
                                @foreach (var (art, name) in PdfBerichtOptionen.Kartenarten)
                                {
                                    <option value="@art">@name</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="border rounded p-2 mb-3">
                    <div class="small fw-semibold mb-2">Einsatz-Zusammenfassung</div>
                    <div class="row g-2 small text-muted">
                        <div class="col-6 col-md-3">Teams: @EinsatzService.Teams.Count</div>
                        <div class="col-6 col-md-3">Personal: @SelectedPersonnelNames.Count</div>
                        <div class="col-6 col-md-3">Hunde: @SelectedDogNames.Count</div>
                        <div class="col-6 col-md-3">Notizen/Funk: @EinsatzService.GlobalNotes.Count</div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-2 h-100">
                            <div class="small fw-semibold mb-2">Welches Personal war vor Ort?</div>
                            <div class="monitor-checklist-scroll">
                                @if (!ActivePersonnel.Any())
                                {
                                    <div class="small text-muted">Kein aktives Personal vorhanden.</div>
                                }
                                else
                                {
                                    @foreach (var person in ActivePersonnel)
                                    {
                                        <label class="form-check d-block mb-1">
                                            <input class="form-check-input" type="checkbox" checked="@_selectedPersonnelIds.Contains(person.Id)" @onchange="args => TogglePersonnelSelection(person.Id, args)" />
                                            <span class="form-check-label">@person.FullName</span>
                                        </label>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-2 h-100">
                            <div class="small fw-semibold mb-2">Welche Hunde waren im Einsatz?</div>
                            <div class="monitor-checklist-scroll">
                                @if (!ActiveDogs.Any())
                                {
                                    <div class="small text-muted">Keine aktiven Hunde vorhanden.</div>
                                }
                                else
                                {
                                    @foreach (var dog in ActiveDogs)
                                    {
                                        <label class="form-check d-block mb-1">
                                            <input class="form-check-input" type="checkbox" checked="@_selectedDogIds.Contains(dog.Id)" @onchange="args => ToggleDogSelection(dog.Id, args)" />
                                            <span class="form-check-label">@dog.Name</span>
                                        </label>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <label class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" @bind="_closeMissionChecklistConfirmed" />
                    <span class="form-check-label">Ich habe die eingesetzten Ressourcen und Beteiligten geprüft.</span>
                </label>
            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseCloseMissionModal" disabled="@_closingMission">Abbrechen</button>
                <button class="btn btn-primary" @onclick="ConfirmCloseMissionAsync" disabled="@_closingMission">
                    @(_closingMission ? "Wird abgeschlossen..." : "Einsatz beenden & archivieren")
                </button>
            </div>
        </div>
    </div>
}

@if (_showPauseResetModal)
{
    var pauseTeam = EinsatzService.Teams.FirstOrDefault(t => t.TeamId == _pauseResetTeamId);
    @if (pauseTeam is not null)
    {
        <div class="modal-overlay">
            <button type="button" class="modal-overlay-dismiss" @onclick="ClosePauseResetModal" aria-label="Dialog schließen"></button>
            <div class="modal-modern modal-modern--480" @onclick:stopPropagation="true">
                <div class="modal-modern-header modal-modern-header--warning">
                    <h4 class="mb-0"><i class="bi bi-pause-circle-fill me-2"></i>Pflichtpause nicht abgeschlossen</h4>
                    <button class="btn btn-sm btn-outline-dark" @onclick="ClosePauseResetModal">X</button>
                </div>
                <div class="modal-modern-body">
                    <div class="alert alert-warning py-2 mb-3">
                        <strong>@pauseTeam.DogName</strong> hat noch nicht die volle Pflichtpause erreicht.
                    </div>
                    <table class="table table-sm mb-3">
                        <tbody>
                            <tr>
                                <td>Gelaufene Zeit</td>
                                <td><strong>@((int)pauseTeam.RunTimeBeforePause.TotalMinutes) Minuten</strong></td>
                            </tr>
                            <tr>
                                <td>Pflichtpause</td>
                                <td><strong>@pauseTeam.RequiredPauseMinutes Minuten</strong>
                                    @if (pauseTeam.RunTimeBeforePause.TotalMinutes <= 20)
                                    {
                                        <span class="text-muted"> (≤ 20 Min. gelaufen → 60 Min. Pause)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted"> (> 20 Min. gelaufen → 3 Std. Pause)</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>Bisherige Pause</td>
                                <td><strong>@((int)pauseTeam.PausedDuration.TotalMinutes) Minuten</strong></td>
                            </tr>
                            <tr class="table-danger">
                                <td>Noch erforderlich</td>
                                <td><strong>@pauseTeam.RemainingPauseMinutes Minuten</strong></td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="small text-muted mb-0">
                        Wenn Sie den Timer trotzdem zurücksetzen, übernehmen Sie die Verantwortung
                        für die Gesundheit des Hundes. Bitte nur im absoluten Ausnahmefall fortfahren.
                    </p>
                </div>
                <div class="modal-modern-footer">
                    <button class="btn btn-outline-secondary" @onclick="ClosePauseResetModal">Abbrechen</button>
                    <button class="btn btn-primary" @onclick="ConfirmResetTeamAsync">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Trotzdem zurücksetzen
                    </button>
                </div>
            </div>
        </div>
    }
}

@if (_showEditEinsatzModal)
{
    <div class="modal-overlay">
        <button type="button" class="modal-overlay-dismiss" @onclick="CloseEditEinsatzModal" aria-label="Dialog schließen"></button>
        <div class="modal-modern modal-modern--640" @onclick:stopPropagation="true">
            <div class="modal-modern-header">
                <h3><i class="bi bi-pencil-square me-2"></i>Einsatz bearbeiten</h3>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseEditEinsatzModal">Schließen</button>
            </div>
            <div class="modal-modern-body">
                @if (!string.IsNullOrWhiteSpace(_editEinsatzMessage))
                {
                    <div class="alert @(_editEinsatzIsError ? "alert-danger" : "alert-success") py-2">@_editEinsatzMessage</div>
                }

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Typ</label>
                        <select class="form-select" @bind="_editEinsatzForm.IstEinsatz">
                            <option value="true">Einsatz</option>
                            <option value="false">Übung</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Polizei-Einsatznummer</label>
                        <input class="form-control" @bind="_editEinsatzForm.EinsatzNummer" placeholder="z. B. EVD-2026-001" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Alarmierungszeit</label>
                        <input class="form-control" type="time" step="60"
                               value="@_editEinsatzForm.AlarmierungsZeit"
                               @onchange="e => _editEinsatzForm.AlarmierungsZeit = e.Value?.ToString() ?? _editEinsatzForm.AlarmierungsZeit" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Einsatzort <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editEinsatzForm.Einsatzort" placeholder="Strasse, Ort" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Karten-Adresse</label>
                        <input class="form-control" @bind="_editEinsatzForm.MapAddress" placeholder="Adresse für Kartensuche" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Alarmiert durch (Melder)</label>
                        <input class="form-control" @bind="_editEinsatzForm.Alarmiert" placeholder="z. B. Leitstelle" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Anzahl Teams (geplant)</label>
                        <input class="form-control" type="number" min="0" @bind="_editEinsatzForm.AnzahlTeams" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Einsatzleiter</label>
                        <div class="input-group">
                            <select class="form-select" @onchange="e => _editEinsatzForm.Einsatzleiter = e.Value?.ToString() ?? _editEinsatzForm.Einsatzleiter">
                                <option value="">- aus Stammdaten -</option>
                                @foreach (var p in SelectionListOrdering.OrderPersonnelByFirstName(_personalList.Where(x => x.IsActive && x.Skills.HasFlag(PersonalSkills.Einsatzleiter))))
                                {
                                    <option value="@p.FullName">@p.FullName</option>
                                }
                            </select>
                            <input class="form-control" @bind="_editEinsatzForm.Einsatzleiter" placeholder="oder Freitext" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Führungsassistent</label>
                        <div class="input-group">
                            <select class="form-select" @onchange="e => _editEinsatzForm.Fuehrungsassistent = e.Value?.ToString() ?? _editEinsatzForm.Fuehrungsassistent">
                                <option value="">- aus Stammdaten -</option>
                                @foreach (var p in SelectionListOrdering.OrderPersonnelByFirstName(_personalList.Where(x => x.IsActive && x.Skills.HasFlag(PersonalSkills.Fuehrungsassistent))))
                                {
                                    <option value="@p.FullName">@p.FullName</option>
                                }
                            </select>
                            <input class="form-control" @bind="_editEinsatzForm.Fuehrungsassistent" placeholder="oder Freitext" />
                        </div>
                    </div>
                    <div class="col-12">
                        <hr class="my-1" />
                        <h4 class="h6 mb-0"><i class="bi bi-shield me-1" aria-hidden="true"></i>Polizei-Kontakt</h4>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Name Kontaktbeamter</label>
                        <input class="form-control" @bind="_editEinsatzForm.PolizeiKontaktName" placeholder="PHK Müller" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Dienstnummer / Rufname</label>
                        <input class="form-control" @bind="_editEinsatzForm.PolizeiDienstnummer" placeholder="z. B. 1234 oder Florian 5" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Telefon</label>
                        <input class="form-control" @bind="_editEinsatzForm.PolizeiTelefon" placeholder="+49 ..." />
                    </div>
                    <div class="col-12">
                        <div class="row g-1">
                            @foreach (var (label, getter, setter) in GetPolizeiChecklist())
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked="@getter()" @onchange="e => setter((bool)(e.Value ?? false))" />
                                        <label class="form-check-label small">@label</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <h4 class="h6 mb-0"><i class="bi bi-truck me-1" aria-hidden="true"></i>Weitere BOS / Feuerwehr</h4>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Einheit</label>
                        <input class="form-control" @bind="_editEinsatzForm.BosEinheit" placeholder="z. B. FF Musterstadt" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Zugführer</label>
                        <input class="form-control" @bind="_editEinsatzForm.BosZugfuehrer" placeholder="Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Funkrufname</label>
                        <input class="form-control" @bind="_editEinsatzForm.BosFunkrufname" placeholder="z. B. Florian 1/20" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Aufgabenteilung</label>
                        <input class="form-control" @bind="_editEinsatzForm.BosAufgabenteilung" placeholder="z. B. Feuerwehr übernimmt Wassersuche" />
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="_editEinsatzForm.BosAbschnittAbgestimmt" />
                            <label class="form-check-label small">Einsatzabschnitt abgestimmt</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="_editEinsatzForm.BosRessourcenBesprochen" />
                            <label class="form-check-label small">Ressourcen besprochen (Wärmebild etc.)</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Bemerkungen</label>
                        <textarea class="form-control" rows="3" @bind="_editEinsatzForm.Bemerkungen" placeholder="Weitere Informationen zum Einsatz"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseEditEinsatzModal">Abbrechen</button>
                <button class="btn btn-primary" @onclick="SaveEditEinsatzAsync">
                    <i class="bi bi-check-lg me-1"></i>Speichern
                </button>
            </div>
        </div>
    </div>
}

@if (_showVermisstenModal)
{
    <div class="modal-overlay">
        <button type="button" class="modal-overlay-dismiss" @onclick="CloseVermisstenModal" aria-label="Dialog schließen"></button>
        <div class="modal-modern modal-modern--lg" @onclick:stopPropagation="true">
            <div class="modal-modern-header">
                <h3><i class="bi bi-person-exclamation me-2"></i>Vermissteninfo</h3>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseVermisstenModal">Schließen</button>
            </div>
            <div class="modal-modern-body">

                @if (!string.IsNullOrWhiteSpace(_vermisstenMessage))
                {
                    <div class="alert @(_vermisstenIsError ? "alert-danger" : "alert-success") py-2">@_vermisstenMessage</div>
                }

                <h6 class="text-muted text-uppercase small fw-bold mb-2">Person</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label form-label-sm">Vorname</label>
                        <input class="form-control form-control-sm" @bind="_vForm.Vorname" placeholder="Vorname" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label form-label-sm">Nachname</label>
                        <input class="form-control form-control-sm" @bind="_vForm.Nachname" placeholder="Nachname" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Geburtsdatum</label>
                        <input class="form-control form-control-sm"
                               value="@_vForm.Geburtsdatum"
                               @onchange="OnVFormGeburtsdatumChanged"
                               placeholder="TT.MM.JJJJ" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Alter <small class="text-muted">(auto.)</small></label>
                        <input class="form-control form-control-sm" @bind="_vForm.Alter" placeholder="z.B. 73" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Kleidung</label>
                        <input class="form-control form-control-sm" @bind="_vForm.Kleidung" placeholder="z.B. blaue Jacke, braune Hose" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Besonderheiten / Körpergröße</label>
                        <input class="form-control form-control-sm" @bind="_vForm.Besonderheiten" placeholder="z.B. ca. 175 cm, Brille" />
                    </div>
                </div>

                <h6 class="text-muted text-uppercase small fw-bold mb-2">Letzter bekannter Aufenthalt</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Ort</label>
                        <input class="form-control form-control-sm" @bind="_vForm.ZuletztGesehenOrt" placeholder="z.B. Parkplatz Waldstraße 12" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label form-label-sm">Uhrzeit</label>
                        <input class="form-control form-control-sm" @bind="_vForm.ZuletztGesehenZeit" placeholder="z.B. 14:30" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label form-label-sm">Gesehen von</label>
                        <input class="form-control form-control-sm" @bind="_vForm.ZuletztGesehenVon" placeholder="z.B. Tochter" />
                    </div>
                </div>

                <h6 class="text-muted text-uppercase small fw-bold mb-2">Medizin &amp; Verhalten</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label form-label-sm">Orientierung</label>
                        <select class="form-select form-select-sm" @bind="_vForm.Orientierung">
                            @foreach (var v in Enum.GetValues<Einsatzueberwachung.Domain.Models.OrientierungsStatus>())
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label form-label-sm">Mobilität</label>
                        <select class="form-select form-select-sm" @bind="_vForm.Mobilitaet">
                            @foreach (var v in Enum.GetValues<Einsatzueberwachung.Domain.Models.MobilitaetsStatus>())
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Suizidrisiko</label>
                        <select class="form-select form-select-sm @(_vForm.Suizidrisiko == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja ? "border-danger" : "")" @bind="_vForm.Suizidrisiko">
                            @foreach (var v in Enum.GetValues<Einsatzueberwachung.Domain.Models.RisikoStatus>())
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Bewaffnet</label>
                        <select class="form-select form-select-sm @(_vForm.Bewaffnet == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja ? "border-danger" : "")" @bind="_vForm.Bewaffnet">
                            @foreach (var v in Enum.GetValues<Einsatzueberwachung.Domain.Models.RisikoStatus>())
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Vorerkrankungen</label>
                        <input class="form-control form-control-sm" @bind="_vForm.Vorerkrankungen" placeholder="z.B. Demenz, Diabetes" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Medikamente</label>
                        <input class="form-control form-control-sm" @bind="_vForm.Medikamente" placeholder="z.B. Metformin, Blutverdünner" />
                    </div>
                </div>

            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseVermisstenModal">Abbrechen</button>
                <button class="btn btn-primary" @onclick="SaveVermisstenAsync">
                    <i class="bi bi-check-lg me-1"></i>Speichern
                </button>
            </div>
        </div>
    </div>
}

@if (_showTeamModal)
{
    <div class="modal-overlay">
        <button type="button" class="modal-overlay-dismiss" @onclick="CloseTeamModal" aria-label="Dialog schließen"></button>
        <div class="modal-modern" @onclick:stopPropagation="true">
            <div class="modal-modern-header">
                <h3>@(_editingTeamId is null ? "Team anlegen" : "Team bearbeiten")</h3>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseTeamModal">Schließen</button>
            </div>
            <div class="modal-modern-body">
                @if (!string.IsNullOrWhiteSpace(_teamFormMessage))
                {
                    <div class="alert @(_teamFormIsError ? "alert-danger" : "alert-success") py-2">@_teamFormMessage</div>
                }

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Teamtyp</label>
                        <select class="form-select" @bind="_teamForm.TeamType" @bind:after="OnTeamTypeChangedAsync">
                            <option value="dog">Hundeteam</option>
                            <option value="drone">Drohnenteam</option>
                            <option value="support">Support-Team</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Teamname</label>
                        <input class="form-control" @bind="_teamForm.TeamName" placeholder="z. B. Team Alpha" />
                    </div>

                    @if (_teamForm.TeamType == "dog")
                    {
                        <div class="col-12">
                            <label class="form-label">Hund</label>
                            <select class="form-select" value="@_teamForm.DogId" @onchange="OnDogChangedAsync">
                                <option value="">Hund auswählen</option>
                                @foreach (var dog in AvailableDogs)
                                {
                                    <option value="@dog.Id">@dog.Name (@dog.SpecializationsShortDisplay)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Hundeführer</label>
                            <select class="form-select" @bind="_teamForm.HundefuehrerId" @bind:after="OnHandlerChangedAsync">
                                <option value="">Hundeführer auswählen</option>
                                @foreach (var person in HundefuehrerOptions)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Helfer 1</label>
                            <select class="form-select" @bind="_teamForm.HelferId">
                                <option value="">Helfer auswählen</option>
                                @foreach (var person in HelferOptions)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Helfer 2 <span class="text-muted small">(optional)</span></label>
                            <select class="form-select" @bind="_teamForm.HelferId2">
                                <option value="">— kein zweiter Helfer —</option>
                                @foreach (var person in HelferOptions)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Helfer 3 <span class="text-muted small">(optional)</span></label>
                            <select class="form-select" @bind="_teamForm.HelferId3">
                                <option value="">— kein dritter Helfer —</option>
                                @foreach (var person in HelferOptions)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>
                    }
                    else if (_teamForm.TeamType == "drone")
                    {
                        <div class="col-12">
                            <label class="form-label">Drohne</label>
                            <select class="form-select" @bind="_teamForm.DroneId" @bind:after="OnDroneChangedAsync">
                                <option value="">Drohne auswählen</option>
                                @foreach (var drone in AvailableDrones)
                                {
                                    <option value="@drone.Id">@drone.DisplayName (@drone.FullDescription)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Pilot</label>
                            <select class="form-select" @bind="_teamForm.HundefuehrerId">
                                <option value="">Pilot auswählen</option>
                                @foreach (var person in DrohnenpilotOptions)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Unterstützung</label>
                            <select class="form-select" @bind="_teamForm.HelferId">
                                <option value="">Person auswählen</option>
                                @foreach (var person in ActivePersonnel)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label class="form-label">Leitung / Führung</label>
                            <select class="form-select" @bind="_teamForm.HundefuehrerId">
                                <option value="">Person auswählen</option>
                                @foreach (var person in ActivePersonnel)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Zweite Person</label>
                            <select class="form-select" @bind="_teamForm.HelferId">
                                <option value="">Person auswählen</option>
                                @foreach (var person in ActivePersonnel)
                                {
                                    <option value="@person.Id">@person.FullName</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="col-12">
                        <label class="form-label">Suchgebiet</label>
                        <select class="form-select" @bind="_teamForm.SearchAreaId">
                            <option value="">Kein Gebiet</option>
                            @foreach (var area in EinsatzService.CurrentEinsatz.SearchAreas.OrderBy(area => area.Name))
                            {
                                <option value="@area.Id">@area.Name</option>
                            }
                        </select>
                    </div>

                    @if (_teamForm.TeamType == "dog")
                    {
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-broadcast me-1"></i>GPS-Halsband</label>
                            <select class="form-select" @bind="_teamForm.CollarId">
                                <option value="">-- Kein Halsband --</option>
                                @foreach (var collar in CollarTrackingService.Collars
                                    .Where(c => !c.IsAssigned || c.Id == _teamForm.CollarId)
                                    .OrderBy(c => c.CollarName))
                                {
                                    <option value="@collar.Id">@collar.CollarName [@collar.Id]</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label">Warnung 1 (Minuten)</label>
                        <input class="form-control" type="number" min="1" @bind="_teamForm.FirstWarningMinutes" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Warnung 2 (Minuten)</label>
                        <input class="form-control" type="number" min="1" @bind="_teamForm.SecondWarningMinutes" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Notizen</label>
                        <textarea class="form-control" rows="3" @bind="_teamForm.Notes"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-primary" @onclick="SaveTeamAsync">@(_editingTeamId is null ? "Team speichern" : "Änderungen speichern")</button>
                <button class="btn btn-outline-secondary" @onclick="ResetTeamForm">Formular leeren</button>
            </div>
        </div>
    </div>
}

@if (_showTeamMessageModal)
{
    <div class="modal-overlay">
        <button type="button" class="modal-overlay-dismiss" @onclick="CloseTeamMessageModal" aria-label="Dialog schließen"></button>
        <div class="modal-modern modal-modern--md" @onclick:stopPropagation="true">
            <div class="modal-modern-header bg-warning text-dark">
                <h3 class="mb-0"><i class="bi bi-megaphone me-1"></i>Nachricht an Team</h3>
                <button class="btn btn-sm btn-outline-dark" @onclick="CloseTeamMessageModal">X</button>
            </div>
            <div class="modal-modern-body">
                @if (EinsatzService.Teams.Count == 0)
                {
                    <div class="alert alert-info">Keine Teams im Einsatz.</div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Empfänger</label>
                        <select class="form-select" @bind="_teamMessageTargetId">
                            @foreach (var t in EinsatzService.Teams.OrderBy(t => t.TeamName))
                            {
                                <option value="@t.TeamId">@t.TeamName @(string.IsNullOrWhiteSpace(t.DogName) ? "" : " / " + t.DogName)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nachricht</label>
                        <textarea class="form-control" rows="3" @bind="_teamMessageText" placeholder="kurze Nachricht..."></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(_teamMessageFeedback))
                    {
                        <div class="alert @(_teamMessageFeedback.StartsWith("Nachricht") ? "alert-success" : "alert-danger") py-2 mb-0">@_teamMessageFeedback</div>
                    }
                    <p class="small text-muted mt-2 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Erscheint sofort am Smartphone des gewaehlten Teams (max. 5 letzte Nachrichten).
                    </p>
                }
            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-warning" @onclick="SendTeamMessage" disabled="@(EinsatzService.Teams.Count == 0)">Senden</button>
                <button class="btn btn-outline-secondary" @onclick="CloseTeamMessageModal">Schließen</button>
            </div>
        </div>
    </div>
}

@if (_showTeamMobileModal)
{
    <div class="modal-overlay">
        <button type="button" class="modal-overlay-dismiss" @onclick="CloseTeamMobileModal" aria-label="Dialog schließen"></button>
        <div class="modal-modern modal-modern--md" @onclick:stopPropagation="true">
            <div class="modal-modern-header bg-success text-white">
                <h3 class="mb-0"><i class="bi bi-qr-code me-1"></i>Team-Mobile Anmelde-Code</h3>
                <button class="btn btn-sm btn-outline-light" @onclick="CloseTeamMobileModal">X</button>
            </div>
            <div class="modal-modern-body text-center">
                @if (string.IsNullOrEmpty(_teamMobileFullUrl))
                {
                    <div class="alert alert-warning">
                        Es ist gerade kein Einsatz aktiv. Starte einen Einsatz, um einen Anmelde-Code zu generieren.
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-2">
                        Teams scannen diesen QR-Code mit dem Smartphone, um sich auf <strong>/team/login</strong> anzumelden.
                    </p>
                    <img src="@_teamMobileQrDataUrl" alt="QR-Code" class="monitor-qr-image" />
                    @if (!string.IsNullOrEmpty(TeamMobileTokenService.CurrentMasterToken))
                    {
                        @* Zum Vorlesen per Funk oder Abtippen auf /team/login, wenn ein Handy den QR-Code nicht scannt *@
                        <div class="monitor-team-code" aria-label="Anmelde-Code">@TeamCodeLesbar(TeamMobileTokenService.CurrentMasterToken)</div>
                        <div class="small text-muted">Anmelde-Code – auf <strong>/team/login</strong> eintippen</div>
                    }
                    <div class="mt-3">
                        <input type="text" class="form-control text-center" readonly value="@_teamMobileFullUrl" onclick="this.select()" />
                    </div>
                    <p class="small text-muted mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Der Code wird beim Einsatz-Ende automatisch ungültig.
                    </p>
                }
            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseTeamMobileModal">Schließen</button>
            </div>
        </div>
    </div>
}
