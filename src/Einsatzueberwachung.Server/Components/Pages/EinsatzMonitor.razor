@page "/einsatz-monitor"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Einsatzueberwachung.Domain.Models
@using Einsatzueberwachung.Domain.Models.Enums

<PageTitle>Einsatz-Monitor</PageTitle>

<div class="monitor-dashboard-wrapper">
    @if (!string.IsNullOrWhiteSpace(_closeMissionStatus))
    {
        <div class="alert @(_closeMissionStatusIsError ? "alert-warning" : "alert-success") mx-2 mb-0 mt-2 py-2">
            @_closeMissionStatus
        </div>
    }


    @if (!HasActiveEinsatz)
    {
        <div class="monitor-screensaver">
            <div class="monitor-screensaver-logo">
                <img src="/downloads/staffel-logo"
                     onerror="this.style.display='none'"
                     alt="Staffel-Logo" />
            </div>
            <div class="monitor-screensaver-clock">
                <div class="monitor-screensaver-time">@_screensaverNow.ToString("HH:mm:ss")</div>
                <div class="monitor-screensaver-date">@_screensaverNow.ToString("dddd, dd. MMMM yyyy", new System.Globalization.CultureInfo("de-DE"))</div>
            </div>
            <div class="monitor-screensaver-ticker-wrap">
                <div class="monitor-screensaver-ticker">
                    @string.Join("   ·   ", _screensaverTips)
                </div>
            </div>
        </div>
    }
    else
    {

    <main id="monitor-dashboard-grid" class="monitor-dashboard-grid" aria-label="Einsatz-Dashboard">
        @if (_currentLayout.Any(p => p.IsVisible && IsSummaryPanel(p.PanelId)))
        {
            <section class="monitor-summary-grid @(_summaryGridCollapsed ? "is-collapsed" : "")"
                     aria-labelledby="monitor-summary-heading">
                <div class="monitor-summary-grid-header">
                    <h2 class="monitor-summary-grid-title" id="monitor-summary-heading">Einsatzinformationen</h2>
                    <button class="monitor-summary-toggle"
                            type="button"
                            aria-controls="monitor-summary-tiles"
                            aria-expanded="@(!_summaryGridCollapsed).ToString().ToLowerInvariant()"
                            aria-label="@(_summaryGridCollapsed ? "Einsatzinformationen einblenden" : "Einsatzinformationen ausblenden")"
                            @onclick="ToggleSummaryGrid">
                        <span>@(_summaryGridCollapsed ? "Einblenden" : "Ausblenden")</span>
                        <i class="bi bi-chevron-@(_summaryGridCollapsed ? "down" : "up")" aria-hidden="true"></i>
                    </button>
                </div>
                <div id="monitor-summary-tiles"
                     class="monitor-summary-grid-tiles"
                     hidden="@_summaryGridCollapsed">
                    @foreach (var summaryPanel in _currentLayout.Where(p => p.IsVisible && IsSummaryPanel(p.PanelId)))
                    {
                    @if (summaryPanel.PanelId == KnownPanels.EinsatzInfo)
                    {
                        var einsatz = EinsatzService.CurrentEinsatz;
                        var policeContacts = GetPoliceContactSummaries();
                        var bosContactSummary = GetBosContactSummary();
                        var hasPoliceNumber = !string.IsNullOrWhiteSpace(einsatz.EinsatzNummer);
                        var hasBosContact = !string.IsNullOrWhiteSpace(bosContactSummary);
                        var showActionsOnNumber = hasPoliceNumber;
                        var showActionsOnPoliceContact = !hasPoliceNumber && policeContacts.Count > 0;
                        var showActionsOnBosContact = !hasPoliceNumber && policeContacts.Count == 0 && hasBosContact;
                        var hasEinsatzTile = hasPoliceNumber || policeContacts.Count > 0 || hasBosContact;

                        @if (hasPoliceNumber)
                        {
                            <article class="monitor-info-tile monitor-info-tile--number">
                                <div class="monitor-info-tile-header">
                                    <span class="monitor-info-tile-label">Einsatz</span>
                                    @if (showActionsOnNumber)
                                    {
                                        <div class="monitor-info-tile-actions">
                                            <button class="monitor-summary-edit-button" type="button" @onclick="OpenEditEinsatzModal" title="Einsatzdaten bearbeiten" aria-label="Einsatzdaten bearbeiten">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <strong class="monitor-info-tile-value">#@einsatz.EinsatzNummer</strong>
                                @if (einsatz.AlarmierungsZeit.HasValue)
                                {
                                    <span class="monitor-info-tile-secondary">
                                        <i class="bi bi-clock me-1" aria-hidden="true"></i>
                                        Alarmierung @einsatz.AlarmierungsZeit.Value.ToString("HH:mm") Uhr
                                    </span>
                                }
                            </article>
                        }

                        @for (var contactIndex = 0; contactIndex < policeContacts.Count; contactIndex++)
                        {
                            var contact = policeContacts[contactIndex];
                            var attachActions = showActionsOnPoliceContact && contactIndex == 0;
                            var hasContactName = !string.IsNullOrWhiteSpace(contact.ContactName);
                            var hasServiceNumber = !string.IsNullOrWhiteSpace(contact.ServiceNumber);
                            var hasPhone = !string.IsNullOrWhiteSpace(contact.Phone);
                            <article class="monitor-info-tile">
                                <div class="monitor-info-tile-header">
                                    <span class="monitor-info-tile-label">@(policeContacts.Count > 1 ? $"Polizei · {contact.PersonName}" : "Polizeikontakt")</span>
                                    @if (attachActions)
                                    {
                                        <div class="monitor-info-tile-actions">
                                            <button class="monitor-summary-edit-button" type="button" @onclick="OpenEditEinsatzModal" title="Einsatzdaten bearbeiten" aria-label="Einsatzdaten bearbeiten">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <div class="monitor-info-contact">
                                    @if (hasContactName || hasServiceNumber)
                                    {
                                        <div class="monitor-info-contact-primary">
                                            @if (hasContactName)
                                            {
                                                <strong class="monitor-info-tile-value">@contact.ContactName</strong>
                                            }
                                            @if (hasServiceNumber)
                                            {
                                                <span class="monitor-summary-person-meta">#@contact.ServiceNumber</span>
                                            }
                                        </div>
                                    }
                                    @if (hasPhone)
                                    {
                                        <span class="monitor-info-phone" aria-label="Telefonnummer @contact.Phone">
                                            <i class="bi bi-telephone" aria-hidden="true"></i>@contact.Phone
                                        </span>
                                    }
                                </div>
                            </article>
                        }

                        @if (hasBosContact)
                        {
                            <article class="monitor-info-tile">
                                <div class="monitor-info-tile-header">
                                    <span class="monitor-info-tile-label">BOS-Kontakt</span>
                                    @if (showActionsOnBosContact)
                                    {
                                        <div class="monitor-info-tile-actions">
                                            <button class="monitor-summary-edit-button" type="button" @onclick="OpenEditEinsatzModal" title="Einsatzdaten bearbeiten" aria-label="Einsatzdaten bearbeiten">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <span class="monitor-info-tile-value">@bosContactSummary</span>
                            </article>
                        }

                        @if (!hasEinsatzTile)
                        {
                            <div class="monitor-info-actions" aria-label="Einsatz-Info bearbeiten">
                                <button class="monitor-summary-edit-button" type="button" @onclick="OpenEditEinsatzModal" title="Einsatzdaten bearbeiten" aria-label="Einsatzdaten bearbeiten">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </div>
                        }

                        <div id="panel-details-@KnownPanels.EinsatzInfo" class="monitor-info-details" hidden="@(!_einsatzInfoDetailsExpanded)">
                            <dl class="monitor-summary-detail-grid mb-0 small">
                                <div>
                                    <dt>Teams</dt>
                                    <dd>@EinsatzService.Teams.Count / @einsatz.AnzahlTeams geplant</dd>
                                </div>
                                <div>
                                    <dt>Datum</dt>
                                    <dd>@einsatz.EinsatzDatum.ToString("dd.MM.yyyy HH:mm")</dd>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(einsatz.Einsatzleiter))
                                {
                                    <div>
                                        <dt>Einsatzleiter</dt>
                                        <dd>@einsatz.Einsatzleiter</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(einsatz.Fuehrungsassistent))
                                {
                                    <div>
                                        <dt>FA</dt>
                                        <dd>@einsatz.Fuehrungsassistent</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(einsatz.Alarmiert))
                                {
                                    <div>
                                        <dt>Alarmiert durch</dt>
                                        <dd>@einsatz.Alarmiert</dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    }
                    else if (summaryPanel.PanelId == KnownPanels.Vermissten)
                    {
                        var vermissteList = EinsatzService.CurrentEinsatz.Vermisste ?? new();
                        var allowMulti = EinsatzService.CurrentEinsatz.Szenario.AllowsMultipleVermisste();
                        VermisstenInfo? activeVi = null;
                        if (vermissteList.Count > 0)
                        {
                            activeVi = (_vermisstenPanelSelectedId.HasValue
                                ? vermissteList.FirstOrDefault(v => v.Id == _vermisstenPanelSelectedId.Value)
                                : null) ?? vermissteList[0];
                        }

                        @if (activeVi is not null)
                        {
                            var vi = activeVi;
                            var hasPersonSummary = !string.IsNullOrWhiteSpace(vi.VollerName)
                                || !string.IsNullOrWhiteSpace(vi.Alter)
                                || vi.Mobilitaet != MobilitaetsStatus.Unbekannt
                                || vi.Suizidrisiko == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja
                                || vi.Bewaffnet == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja
                                || !string.IsNullOrWhiteSpace(vi.Vorerkrankungen)
                                || !string.IsNullOrWhiteSpace(vi.Medikamente)
                                || !string.IsNullOrWhiteSpace(vi.Kleidung)
                                || !string.IsNullOrWhiteSpace(vi.ZuletztGesehenOrt)
                                || !string.IsNullOrWhiteSpace(vi.ZuletztGesehenZeit);

                            @if (hasPersonSummary)
                            {
                                <article class="monitor-info-tile monitor-info-tile--person">
                                    <div class="monitor-info-tile-header">
                                        <span class="monitor-info-tile-label">Vermisste Person</span>
                                        @if (vermissteList.Count > 1 || allowMulti)
                                        {
                                            <div class="vermissten-panel-tabs monitor-summary-person-tabs" role="group" aria-label="Vermisste Person auswählen">
                                                @for (var i = 0; i < vermissteList.Count; i++)
                                                {
                                                    var person = vermissteList[i];
                                                    var index = i + 1;
                                                    var isActive = person.Id == vi.Id;
                                                    <button class="vermissten-panel-tab @(isActive ? "active" : "")"
                                                            type="button"
                                                            aria-pressed="@isActive"
                                                            @onclick="() => _vermisstenPanelSelectedId = person.Id"
                                                            title="@person.VollerName"
                                                            aria-label="Person @index @(string.IsNullOrWhiteSpace(person.VollerName) ? string.Empty : person.VollerName)">
                                                        <span>@index</span>
                                                    </button>
                                                }
                                                @if (allowMulti)
                                                {
                                                    <button class="vermissten-panel-tab vermissten-panel-tab-add" type="button"
                                                            @onclick="OpenVermisstenModalNew" title="Weitere Person erfassen" aria-label="Weitere Person erfassen">
                                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        <div class="monitor-info-tile-actions">
                                            <button class="monitor-summary-edit-button" type="button" @onclick="OpenVermisstenModal" title="Vermisstendaten bearbeiten" aria-label="Vermisstendaten bearbeiten">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="monitor-info-person-main">
                                        @if (!string.IsNullOrWhiteSpace(vi.VollerName))
                                        {
                                            <strong class="monitor-info-tile-value">@vi.VollerName</strong>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(vi.Alter) || vi.Mobilitaet != MobilitaetsStatus.Unbekannt)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(vi.VollerName))
                                            {
                                                <span aria-hidden="true">·</span>
                                            }
                                            <span class="monitor-summary-person-meta">
                                                @if (!string.IsNullOrWhiteSpace(vi.Alter))
                                                {
                                                    <span>@vi.Alter Jahre</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(vi.Alter) && vi.Mobilitaet != MobilitaetsStatus.Unbekannt)
                                                {
                                                    <span aria-hidden="true">·</span>
                                                }
                                                @if (vi.Mobilitaet != MobilitaetsStatus.Unbekannt)
                                                {
                                                    <span>@vi.Mobilitaet</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                    @if (vi.Suizidrisiko == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja
                                        || vi.Bewaffnet == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja
                                        || !string.IsNullOrWhiteSpace(vi.Vorerkrankungen)
                                        || !string.IsNullOrWhiteSpace(vi.Medikamente))
                                    {
                                        <div class="monitor-info-person-indicators">
                                            @if (vi.Suizidrisiko == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja || vi.Bewaffnet == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja)
                                            {
                                                <div class="monitor-summary-alerts" aria-label="Gefahrenhinweise">
                                                    @if (vi.Suizidrisiko == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja)
                                                    {
                                                        <span class="monitor-summary-alert">
                                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>Suizidrisiko
                                                        </span>
                                                    }
                                                    @if (vi.Bewaffnet == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja)
                                                    {
                                                        <span class="monitor-summary-alert">
                                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>Bewaffnet
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(vi.Vorerkrankungen) || !string.IsNullOrWhiteSpace(vi.Medikamente))
                                            {
                                                <div class="monitor-info-tags">
                                                    @if (!string.IsNullOrWhiteSpace(vi.Vorerkrankungen))
                                                    {
                                                        <span class="monitor-info-tag">@vi.Vorerkrankungen</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(vi.Medikamente))
                                                    {
                                                        <span class="monitor-info-tag" aria-label="Medikamente: @vi.Medikamente">
                                                            <i class="bi bi-capsule" aria-hidden="true"></i>@vi.Medikamente
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div id="panel-details-@KnownPanels.Vermissten" class="monitor-info-details monitor-info-details--person" hidden="@(!_vermisstenDetailsExpanded)">
                                        @if (_vermisstenDetailsExpanded)
                                        {
                                            <div class="row g-2 small">
                                                @if (!string.IsNullOrWhiteSpace(vi.Kleidung))
                                                {
                                                    <div class="col-12">
                                                        <div class="vermissten-field-label">Kleidung</div>
                                                        <div class="vermissten-field-value">@vi.Kleidung</div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(vi.ZuletztGesehenOrt) || !string.IsNullOrWhiteSpace(vi.ZuletztGesehenZeit))
                                                {
                                                    <div class="col-12">
                                                        <div class="vermissten-field-label">Zuletzt gesehen</div>
                                                        @if (!string.IsNullOrWhiteSpace(vi.ZuletztGesehenOrt))
                                                        {
                                                            <span class="vermissten-field-value">@vi.ZuletztGesehenOrt</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(vi.ZuletztGesehenZeit))
                                                        {
                                                            <span class="vermissten-field-value"> · @vi.ZuletztGesehenZeit</span>
                                                        }
                                                    </div>
                                                }
                                                @if (vi.ZuletztAktualisiert.HasValue)
                                                {
                                                    <div class="col-12">
                                                        <div class="text-muted monitor-timestamp-small">Stand: @vi.ZuletztAktualisiert.Value.ToString("dd.MM. HH:mm")</div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                            else
                            {
                                <div class="monitor-info-actions" aria-label="Vermissteninfo bearbeiten">
                                    @if (vermissteList.Count > 1 || allowMulti)
                                    {
                                        <div class="vermissten-panel-tabs monitor-summary-person-tabs" role="group" aria-label="Vermisste Person auswählen">
                                            @for (var i = 0; i < vermissteList.Count; i++)
                                            {
                                                var person = vermissteList[i];
                                                var index = i + 1;
                                                var isActive = person.Id == vi.Id;
                                                <button class="vermissten-panel-tab @(isActive ? "active" : "")"
                                                        type="button"
                                                        aria-pressed="@isActive"
                                                        @onclick="() => _vermisstenPanelSelectedId = person.Id"
                                                        title="@person.VollerName"
                                                        aria-label="Person @index @(string.IsNullOrWhiteSpace(person.VollerName) ? string.Empty : person.VollerName)">
                                                    <span>@index</span>
                                                </button>
                                            }
                                            @if (allowMulti)
                                            {
                                                <button class="vermissten-panel-tab vermissten-panel-tab-add" type="button"
                                                        @onclick="OpenVermisstenModalNew" title="Weitere Person erfassen" aria-label="Weitere Person erfassen">
                                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                    <button class="monitor-summary-edit-button" type="button" @onclick="OpenVermisstenModal" title="Vermisstendaten bearbeiten" aria-label="Vermisstendaten bearbeiten">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="monitor-info-actions">
                                <button class="monitor-summary-edit-button" type="button" @onclick="OpenVermisstenModal" title="Vermissteninfo erfassen" aria-label="Vermissteninfo erfassen">
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                    }
                    else if (summaryPanel.PanelId == KnownPanels.Wetter)
                    {
                        var forecastItems = _monitorWeather is null ? new List<WeatherData>() : GetMonitorForecastItems().ToList();
                        var temperatureTrend = GetWeatherTrend("Temperatur", weather => weather.Temperatur, 1, true);
                        var windTrend = GetWeatherTrend("Wind", weather => weather.Windgeschwindigkeit, 0);
                        var rainTrend = GetWeatherTrend("Niederschlag", weather => weather.Niederschlag, 1);
                        var dogHeatWarning = _monitorWeather is not null
                            && (_monitorWeather.Temperatur > 30 || forecastItems.Take(3).Any(item => item.Temperatur > 30));

                        @if (!string.IsNullOrWhiteSpace(_monitorWeatherError) && _monitorWeather is null)
                        {
                            <div class="monitor-info-state monitor-summary-error" role="status">@_monitorWeatherError</div>
                        }
                        @if (_monitorWeather is not null)
                        {
                            <article class="monitor-info-tile monitor-info-tile--weather">
                                <div class="monitor-info-tile-header">
                                    <span class="monitor-info-tile-label">Wetter</span>
                                </div>
                                <div class="monitor-weather-summary">
                                    <div class="monitor-weather-reading monitor-weather-reading--temperature" aria-label="Temperatur" title="Temperatur">
                                        <div class="monitor-weather-value-row">
                                            <strong class="monitor-weather-value monitor-weather-value--temperature"><i class="bi bi-thermometer-half me-1" aria-hidden="true"></i>@_monitorWeather.Temperatur.ToString("0.0")°C</strong>
                                            @if (temperatureTrend.IsAvailable)
                                            {
                                                <span class="monitor-weather-trend @temperatureTrend.CssClass" title="@temperatureTrend.Description" aria-label="@temperatureTrend.Description">
                                                    <i class="bi @temperatureTrend.IconClass" aria-hidden="true"></i>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="monitor-weather-reading monitor-weather-reading--secondary" aria-label="Wind" title="Wind">
                                        <div class="monitor-weather-value-row">
                                            <strong class="monitor-weather-value"><i class="bi bi-wind me-1" aria-hidden="true"></i>@_monitorWeather.Windgeschwindigkeit.ToString("0") km/h</strong>
                                            @if (windTrend.IsAvailable)
                                            {
                                                <span class="monitor-weather-trend @windTrend.CssClass" title="@windTrend.Description" aria-label="@windTrend.Description">
                                                    <i class="bi @windTrend.IconClass" aria-hidden="true"></i>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="monitor-weather-reading monitor-weather-reading--secondary" aria-label="Niederschlag" title="Niederschlag">
                                        <div class="monitor-weather-value-row">
                                            <strong class="monitor-weather-value"><i class="bi bi-droplet me-1" aria-hidden="true"></i>@_monitorWeather.Niederschlag.ToString("0.0") mm/h</strong>
                                            @if (rainTrend.IsAvailable)
                                            {
                                                <span class="monitor-weather-trend @rainTrend.CssClass" title="@rainTrend.Description" aria-label="@rainTrend.Description">
                                                    <i class="bi @rainTrend.IconClass" aria-hidden="true"></i>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (_monitorWeather.HatWarnung || dogHeatWarning)
                                {
                                    <div class="monitor-summary-alerts" role="status">
                                        @if (_monitorWeather.HatWarnung)
                                        {
                                            <span class="monitor-summary-alert">
                                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                DWD: @_monitorWeather.WarnungsStufe
                                            </span>
                                        }
                                        @if (dogHeatWarning)
                                        {
                                            <span class="monitor-summary-alert monitor-summary-alert--heat">
                                                <i class="bi bi-thermometer-high" aria-hidden="true"></i>
                                                Über 30 °C: Hunde beachten
                                            </span>
                                        }
                                    </div>
                                }
                                @if (_monitorWeatherLoading)
                                {
                                    <div class="monitor-weather-refreshing" role="status">Wetter wird aktualisiert …</div>
                                }
                                <div id="panel-details-@KnownPanels.Wetter" class="monitor-info-details monitor-info-details--weather" hidden="@(!_wetterDetailsExpanded)">
                                    @if (_monitorWeather.Windboeen > 0)
                                    {
                                        <div class="small text-muted"><i class="bi bi-wind me-1" aria-hidden="true"></i>Böen: @_monitorWeather.Windboeen.ToString("0") km/h</div>
                                    }
                                    <div class="small text-muted mt-1">
                                        DWD &bull; @_monitorWeatherLoadedAtLocal.ToString("HH:mm") Uhr
                                        @if (_monitorWeatherUsingFallback)
                                        {
                                            <span class="text-warning ms-1">(Fallback)</span>
                                        }
                                    </div>
                                    @if (forecastItems.Count > 0)
                                    {
                                        <div class="forecast-strip mt-2" aria-label="Wettervorhersage für die nächsten Stunden">
                                            @foreach (var item in forecastItems)
                                            {
                                                <div class="forecast-item @(item.Temperatur > 30 ? "forecast-heat-warning" : "")">
                                                    <div class="small fw-bold">@Ortszeit.AusUtc(item.Zeitpunkt).ToString("HH:mm")</div>
                                                    <div class="small">@item.Temperatur.ToString("0")°</div>
                                                    <div class="small text-muted"><i class="bi bi-wind" aria-hidden="true"></i> @item.Windgeschwindigkeit.ToString("0")</div>
                                                    <div class="small text-muted"><i class="bi bi-droplet" aria-hidden="true"></i> @item.Niederschlag.ToString("0.0")</div>
                                                    @if (item.Temperatur > 30)
                                                    {
                                                        <div class="small fw-semibold">Hunde: Hitze</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                        else if (_monitorWeatherLoading)
                        {
                            <div class="monitor-info-state" role="status"><i class="bi bi-cloud me-1" aria-hidden="true"></i>Wetterdaten werden geladen …</div>
                        }
                    }
                    }
                </div>
            </section>
        }

        @{
            var workPanels = _currentLayout
                .Where(panel => panel.IsVisible && !IsSummaryPanel(panel.PanelId))
                .ToArray();
            var tabletPanels = workPanels
                .OrderBy(panel => TabletPanelOrder(panel.PanelId))
                .ToArray();
            var activeTabletPanelId = tabletPanels
                .FirstOrDefault(panel => panel.PanelId == _tabletActivePanelId)?.PanelId
                ?? tabletPanels.FirstOrDefault(panel => panel.PanelId == KnownPanels.Teams)?.PanelId
                ?? tabletPanels.FirstOrDefault()?.PanelId;
        }

        @if (tabletPanels.Length > 1)
        {
            <div class="monitor-tablet-tabs" role="group" aria-label="Lagebereiche">
                @foreach (var tabletPanel in tabletPanels)
                {
                    var isActive = tabletPanel.PanelId == activeTabletPanelId;
                    <button id="monitor-tablet-tab-@tabletPanel.PanelId"
                            class="monitor-tablet-tab @(isActive ? "is-active" : "")"
                            type="button"
                            aria-pressed="@isActive.ToString().ToLowerInvariant()"
                            aria-controls="monitor-tablet-panel-@tabletPanel.PanelId"
                            @onclick="() => SelectTabletPanel(tabletPanel.PanelId)">
                        @PanelLabel(tabletPanel.PanelId)
                    </button>
                }
            </div>
        }

        @foreach (var panel in workPanels)
        {
            var forecastItems = new List<WeatherData>();
            var temperatureTrend = WeatherMetricTrend.Unavailable;
            var windTrend = WeatherMetricTrend.Unavailable;
            var rainTrend = WeatherMetricTrend.Unavailable;
            var dogHeatWarning = false;
            <div @key="panel.PanelId"
                 id="monitor-tablet-panel-@panel.PanelId"
                 class="dashboard-panel-wrapper @(IsSummaryPanel(panel.PanelId) ? "dashboard-panel-wrapper--summary" : "") @(panel.PanelId == activeTabletPanelId ? "" : "monitor-tablet-panel-hidden")"
                 data-panel-id="@panel.PanelId">
                <section class="dashboard-panel" aria-labelledby="panel-title-@panel.PanelId">
                    <div class="dashboard-panel-header @(panel.PanelId == KnownPanels.Teams && EinsatzService.Teams.Count > 0 ? "dashboard-panel-header--teams" : "") @(IsSummaryPanel(panel.PanelId) ? "dashboard-panel-header--summary" : "")">
                        @if (IsSummaryPanel(panel.PanelId))
                        {
                            <h2 class="dashboard-panel-title @(panel.PanelId is KnownPanels.EinsatzInfo or KnownPanels.Vermissten ? "dashboard-panel-title--editable" : "")" id="panel-title-@panel.PanelId">
                                @if (CanExpandSummaryDetails(panel.PanelId))
                                {
                                    <button class="monitor-summary-title-toggle @(panel.PanelId is KnownPanels.EinsatzInfo or KnownPanels.Vermissten ? "monitor-summary-title-toggle--inline" : "")" type="button"
                                            aria-expanded="@IsSummaryDetailsExpanded(panel.PanelId)"
                                            aria-controls="panel-details-@panel.PanelId"
                                            @onclick="() => ToggleSummaryDetails(panel.PanelId)">
                                        <span>@PanelLabel(panel.PanelId)</span>
                                        <i class="bi bi-chevron-@((IsSummaryDetailsExpanded(panel.PanelId)) ? "up" : "down")" aria-hidden="true"></i>
                                    </button>
                                }
                                else
                                {
                                    @PanelLabel(panel.PanelId)
                                }
                            </h2>
                            @if (panel.PanelId == KnownPanels.EinsatzInfo)
                            {
                                <button class="monitor-summary-edit-button" type="button" @onclick="OpenEditEinsatzModal" title="Einsatzdaten bearbeiten" aria-label="Einsatzdaten bearbeiten">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            }
                            else if (panel.PanelId == KnownPanels.Vermissten)
                            {
                                <button class="monitor-summary-edit-button" type="button" @onclick="OpenVermisstenModal"
                                        title="@(EinsatzService.CurrentEinsatz.Vermisste?.Count > 0 ? "Vermisstendaten bearbeiten" : "Vermissteninfo erfassen")"
                                        aria-label="@(EinsatzService.CurrentEinsatz.Vermisste?.Count > 0 ? "Vermisstendaten bearbeiten" : "Vermissteninfo erfassen")">
                                    <i class="bi @(EinsatzService.CurrentEinsatz.Vermisste?.Count > 0 ? "bi-pencil" : "bi-plus-lg")" aria-hidden="true"></i>
                                </button>
                            }
                        }
                        else
                        {
                            <h2 class="dashboard-panel-title" id="panel-title-@panel.PanelId">
                                @if (panel.PanelId == KnownPanels.Teams)
                                {
                                    <a class="dashboard-panel-title-popout"
                                       href="/popout-teams"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="Teams in neuem Fenster öffnen"
                                       title="Team-Übersicht in neuem Fenster öffnen">
                                        <span>@PanelLabel(panel.PanelId)</span>
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                    </a>
                                }
                                else if (panel.PanelId == KnownPanels.Notizen)
                                {
                                    <a class="dashboard-panel-title-popout"
                                       href="/popout-notes"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="Notizen in neuem Fenster öffnen"
                                       title="Notizen in neuem Fenster öffnen">
                                        <span>@PanelLabel(panel.PanelId)</span>
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                    </a>
                                }
                                else
                                {
                                    @PanelLabel(panel.PanelId)
                                }
                            </h2>
                        }
                        @if (panel.PanelId == KnownPanels.Teams)
                        {
                            @if (EinsatzService.Teams.Count > 0)
                            {
                                <div class="monitor-panel-picker-wrapper mon-anchor-teamfilter">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary teams-filter-trigger @(_teamStatusFilter != TeamStatusFilter.All ? "is-filtered" : "")"
                                            @onclick="() => _showTeamFilter = !_showTeamFilter"
                                            aria-haspopup="true" aria-expanded="@_showTeamFilter"
                                            title="Teams nach Status filtern">
                                        <i class="bi bi-funnel" aria-hidden="true"></i>
                                        @if (_teamStatusFilter != TeamStatusFilter.All)
                                        {
                                            <span class="teams-filter-dot @TeamFilterDotClass(_teamStatusFilter)" aria-hidden="true"></span>
                                        }
                                        <span class="teams-filter-trigger-label">@TeamFilterLabel(_teamStatusFilter)</span>
                                        <span class="teams-filter-count">@GetTeamCountForFilter(_teamStatusFilter)</span>
                                    </button>
                                    @if (_showTeamFilter)
                                    {
                                        <div class="panel-picker-dropdown teams-filter-dropdown" role="group" aria-label="Teamstatus Filter">
                                            @foreach (var filter in new[] { TeamStatusFilter.All, TeamStatusFilter.Running, TeamStatusFilter.Pausing, TeamStatusFilter.Ready, TeamStatusFilter.Critical })
                                            {
                                                <button type="button"
                                                        class="teams-filter-option @(_teamStatusFilter == filter ? "active" : "")"
                                                        aria-pressed="@(_teamStatusFilter == filter)"
                                                        @onclick="() => SelectTeamFilter(filter)"
                                                        @onclick:stopPropagation="true">
                                                    @if (filter == TeamStatusFilter.All)
                                                    {
                                                        <i class="bi bi-list-ul teams-filter-option-icon" aria-hidden="true"></i>
                                                    }
                                                    else
                                                    {
                                                        <span class="teams-filter-dot @TeamFilterDotClass(filter)" aria-hidden="true"></span>
                                                    }
                                                    <span class="teams-filter-option-label">@TeamFilterLabel(filter)</span>
                                                    <span class="teams-filter-count">@GetTeamCountForFilter(filter)</span>
                                                </button>
                                            }
                                        </div>
                                        <button type="button"
                                                class="panel-picker-backdrop"
                                                @onclick="() => _showTeamFilter = false"
                                                aria-label="Filter-Menü schließen"></button>
                                    }
                                </div>
                            }
                            <div class="ms-auto d-flex align-items-center gap-2 flex-shrink-0">
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        @onclick="OpenTeamMobileModalAsync"
                                        title="QR-Code für Team-Smartphones"
                                        aria-label="QR-Code für Team-Smartphones">
                                    <i class="bi bi-qr-code" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        @onclick="OpenNewTeamModal"
                                        title="Team hinzufügen"
                                        aria-label="Team hinzufügen">
                                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                        else if (panel.PanelId == KnownPanels.Notizen)
                        {
                            <div class="ms-auto d-flex align-items-center gap-1">
                                <button class="btn btn-sm btn-link text-muted p-1" type="button" @onclick="OpenTeamMessageModal" title="Nachricht an ein Team-Smartphone" aria-label="Nachricht an ein Team-Smartphone">
                                    <i class="bi bi-megaphone" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="dashboard-panel-body">
                        @switch (panel.PanelId)
                        {
                                case KnownPanels.EinsatzInfo:
                                    {
                                    var policeContacts = GetPoliceContactSummaries();
                                    var bosContactSummary = GetBosContactSummary();
                                    <div class="monitor-summary-primary">
                                        <span class="monitor-summary-kicker">Polizei-Einsatznummer</span>
                                        @if (!string.IsNullOrWhiteSpace(EinsatzService.CurrentEinsatz.EinsatzNummer))
                                        {
                                            <strong class="monitor-summary-primary-value">@EinsatzService.CurrentEinsatz.EinsatzNummer</strong>
                                        }
                                        else
                                        {
                                            <strong class="monitor-summary-primary-value monitor-summary-value-missing">Nicht hinterlegt</strong>
                                        }
                                    </div>
                                    <div class="monitor-summary-subline">
                                        <span>@EinsatzService.CurrentEinsatz.EinsatzTyp</span>
                                    </div>
                                    <div class="monitor-summary-key-details">
                                        @if (policeContacts.Count == 0)
                                        {
                                            <div class="monitor-summary-key-detail">
                                                <span class="monitor-summary-key-label">Polizei-Kontakt</span>
                                                <span class="monitor-summary-key-value">Nicht hinterlegt</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var contact in policeContacts)
                                            {
                                                <div class="monitor-summary-key-detail">
                                                    <span class="monitor-summary-key-label">@(EinsatzService.CurrentEinsatz.Vermisste?.Count > 1 ? contact.PersonName : "Polizei-Kontakt")</span>
                                                    <span class="monitor-summary-key-value">@FormatContact(contact.ContactName ?? string.Empty, contact.ServiceNumber ?? string.Empty, contact.Phone ?? string.Empty)</span>
                                                </div>
                                            }
                                        }
                                        <div class="monitor-summary-key-detail">
                                            <span class="monitor-summary-key-label">BOS-Kontakt</span>
                                            <span class="monitor-summary-key-value">@(string.IsNullOrWhiteSpace(bosContactSummary) ? "Nicht hinterlegt" : bosContactSummary)</span>
                                        </div>
                                    </div>
                                    <div id="panel-details-@panel.PanelId" class="monitor-summary-details" hidden="@(!_einsatzInfoDetailsExpanded)">
                                        <dl class="monitor-summary-detail-grid mb-0 small">
                                            <div>
                                                <dt>Teams</dt>
                                                <dd>@EinsatzService.Teams.Count / @EinsatzService.CurrentEinsatz.AnzahlTeams geplant</dd>
                                            </div>
                                            <div>
                                                <dt>Datum</dt>
                                                <dd>@EinsatzService.CurrentEinsatz.EinsatzDatum.ToString("dd.MM.yyyy HH:mm")</dd>
                                            </div>
                                            @if (EinsatzService.CurrentEinsatz.AlarmierungsZeit.HasValue)
                                            {
                                                <div>
                                                    <dt>Alarmierung</dt>
                                                    <dd>@EinsatzService.CurrentEinsatz.AlarmierungsZeit.Value.ToString("HH:mm") Uhr</dd>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(EinsatzService.CurrentEinsatz.Einsatzleiter))
                                            {
                                                <div>
                                                    <dt>Einsatzleiter</dt>
                                                    <dd>@EinsatzService.CurrentEinsatz.Einsatzleiter</dd>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(EinsatzService.CurrentEinsatz.Fuehrungsassistent))
                                            {
                                                <div>
                                                    <dt>FA</dt>
                                                    <dd>@EinsatzService.CurrentEinsatz.Fuehrungsassistent</dd>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(EinsatzService.CurrentEinsatz.Alarmiert))
                                            {
                                                <div>
                                                    <dt>Alarmiert durch</dt>
                                                    <dd>@EinsatzService.CurrentEinsatz.Alarmiert</dd>
                                                </div>
                                            }
                                        </dl>
                                    </div>
                                    break;
                                    }

                                case KnownPanels.Teams:
                                    @if (!string.IsNullOrWhiteSpace(_teamStatusMessage))
                                    {
                                        <div class="alert @(_teamStatusIsError ? "alert-warning" : "alert-success") alert-dismissible py-2 mb-3" role="alert">
                                            @_teamStatusMessage
                                            <button type="button" class="btn-close" @onclick="() => _teamStatusMessage = string.Empty"></button>
                                        </div>
                                    }
                                    @if (EinsatzService.Teams.Count == 0)
                                    {
                                        <div class="alert alert-info mb-0">
                                            Noch keine Teams vorhanden. Klicken Sie auf "Team anlegen".
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="teams-monitor-list" class="teams-monitor-list">
                                            @foreach (var team in OrderTeamsForMonitor(GetFilteredTeams()))
                                            {
                                                var isDogConflict = !team.IsRunning && !team.IsPausing && !team.IsManuallyPaused
                                                    && !string.IsNullOrWhiteSpace(team.DogId)
                                                    && EinsatzService.IsDogRunning(team.DogId);
                                                var conflictingTeamName = isDogConflict
                                                    ? EinsatzService.Teams.FirstOrDefault(t => t.TeamId != team.TeamId && t.IsRunning && t.DogId == team.DogId)?.TeamName
                                                    : null;
                                                <div @key="team.TeamId" class="team-order-item" data-team-id="@team.TeamId">
                                                    <TeamCard Team="team"
                                                              IsDogConflict="isDogConflict"
                                                              ConflictingTeamName="conflictingTeamName"
                                                              DroneList="_droneList"
                                                              IsExpanded="_expandedTeamIds.Contains(team.TeamId)"
                                                              LastCollarLocation="GetLastCollarLocation(team)"
                                                              LastPhoneLocation="EinsatzService.PhoneLocations.GetValueOrDefault(team.TeamId)"
                                                              LatestNoteEntries="GetLatestTeamNoteEntries(team, 3)"
                                                              CompletedSearches="GetCompletedSearches(team, 5)"
                                                              OnStart="StartTeamAsync"
                                                              OnPause="PauseTeamAsync"
                                                              OnStop="StopTeamAsync"
                                                              OnReset="RequestResetTeamAsync"
                                                              OnEdit="id => EditTeam(id)"
                                                              OnToggleExpand="ToggleTeamExpand" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    break;

                                case KnownPanels.Notizen:
                                    <div id="note-expander-form" class="note-input-section mb-3">
                                        <div class="mb-2 d-flex flex-wrap align-items-center gap-1">
                                            <span class="note-source-label">Quelle:</span>
                                            @foreach (var team in EinsatzService.Teams.OrderBy(t => t.TeamName))
                                            {
                                                <button type="button"
                                                        class="btn btn-sm note-source-chip @(_newNoteSourceId == team.TeamId ? "active" : "")"
                                                        @onclick="() => _newNoteSourceId = team.TeamId">
                                                    @team.TeamName
                                                </button>
                                            }
                                            <button type="button"
                                                    class="btn btn-sm note-source-chip @(_newNoteSourceId == "einsatzleitung" ? "active" : "")"
                                                    @onclick='() => _newNoteSourceId = "einsatzleitung"'>
                                                <i class="bi bi-shield-fill me-1"></i>EL
                                            </button>
                                        </div>
                                        <div class="mb-2 d-flex gap-2 align-items-center">
                                            <select class="form-select" aria-label="Art der Nachricht" @bind="_newNoteType">
                                                <option value="Notiz">Notiz</option>
                                                <option value="Funk">Funk</option>
                                            </select>
                                            @if (_quickNoteTemplates.Count > 0)
                                            {
                                                <div class="monitor-panel-picker-wrapper mon-anchor-quicknote flex-shrink-0">
                                                    <button class="btn btn-outline-success" type="button"
                                                            @onclick="() => _showQuickNoteDropdown = !_showQuickNoteDropdown"
                                                            title="Schnell-Notiz" aria-label="Schnell-Notiz einfügen">
                                                        <i class="bi bi-lightning-fill"></i>
                                                    </button>
                                                    @if (_showQuickNoteDropdown)
                                                    {
                                                        <div class="panel-picker-dropdown">
                                                            @foreach (var quickTemplate in _quickNoteTemplates)
                                                            {
                                                                <button class="btn btn-sm w-100 text-start mb-1"
                                                                        @onclick="() => { _ = AddQuickNoteAsync(quickTemplate); _showQuickNoteDropdown = false; }"
                                                                        @onclick:stopPropagation="true">
                                                                    @quickTemplate
                                                                </button>
                                                            }
                                                        </div>
                                                        <button type="button"
                                                                class="panel-picker-backdrop"
                                                                @onclick="() => _showQuickNoteDropdown = false"
                                                                aria-label="Schließen"></button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <label class="form-label monitor-note-compose-label" for="monitor-new-note">
                                            Inhalt der Notiz oder des Funkspruchs
                                        </label>
                                        <MentionTextarea Id="monitor-new-note"
                                                         @bind-Value="_newNoteText"
                                                         Mentions="@GetNoteMentions()"
                                                         Rows="3"
                                                         Placeholder="Text eingeben"
                                                         AdditionalClass="mb-2" />
                                        <button class="btn btn-primary w-100"
                                                @onclick="AddGlobalNoteAsync"
                                                disabled="@(string.IsNullOrWhiteSpace(_newNoteText) || string.IsNullOrWhiteSpace(_newNoteSourceId))">
                                            <i class="bi bi-send-fill"></i> Hinzufügen
                                        </button>
                                    </div>

                                    <div class="notes-list">
                                        @if (EinsatzService.GlobalNotes.Count == 0)
                                        {
                                            <p class="text-muted mb-0">Noch keine Einträge.</p>
                                        }
                                        else
                                        {
                                            @foreach (var note in EinsatzService.GlobalNotes.OrderByDescending(n => n.Timestamp).Take(10))
                                            {
                                                <div class="note-card @GetNoteCssClass(note) @(note.Replies.Count > 0 ? "has-replies" : string.Empty)">
                                                    <div class="monitor-note-header d-flex justify-content-between align-items-baseline gap-2">
                                                        <div class="d-flex align-items-center gap-2">
                                                            @if (GetNoteCssClass(note) == "note-type-teamwarning")
                                                            {
                                                                <i class="bi bi-exclamation-triangle-fill monitor-note-status-icon"
                                                                   role="img" aria-label="Teamwarnung"></i>
                                                            }
                                                            <strong class="monitor-note-author">@(string.IsNullOrWhiteSpace(note.SourceTeamName) ? "System" : note.SourceTeamName)</strong>
                                                        </div>
                                                        <span class="monitor-note-timestamp text-muted">@note.FormattedTimestamp</span>
                                                    </div>
                                                    <div class="monitor-note-content d-flex justify-content-between align-items-start mb-2">
                                                        <div>@MentionTextarea.RenderWithMentions(note.Text)</div>
                                                        <button class="btn btn-sm btn-link p-0 ms-2 text-muted flex-shrink-0"
                                                                type="button"
                                                                @onclick="() => ToggleReplyForm(note.Id)"
                                                                title="Antworten"
                                                                aria-label="Antworten">
                                                            <i class="bi bi-reply-fill" aria-hidden="true"></i>
                                                        </button>
                                                    </div>

                                                    @if (IsReplyFormVisible(note.Id))
                                                    {
                                                        <div class="d-flex gap-2 mb-2">
                                                            <select class="form-select form-select-sm monitor-source-select"
                                                                    value="@GetReplySourceId(note.Id)"
                                                                    @onchange="e => SetReplySourceId(note.Id, e.Value?.ToString())">
                                                                <option value="einsatzleitung">Einsatzleitung</option>
                                                                @foreach (var team in EinsatzService.Teams.OrderBy(team => team.TeamName))
                                                                {
                                                                    <option value="@team.TeamId">@team.TeamName</option>
                                                                }
                                                            </select>
                                                            <input class="form-control form-control-sm"
                                                                   placeholder="Antwort"
                                                                   value="@GetReplyText(note.Id)"
                                                                   @oninput="e => SetReplyText(note.Id, e.Value?.ToString())"
                                                                   @onkeydown="e => HandleReplyKeyDown(note.Id, e)" />
                                                            <button class="btn btn-sm btn-primary" @onclick="() => AddReplyAsync(note.Id)" title="Senden" aria-label="Antwort senden">
                                                                <i class="bi bi-send-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CancelReplyForm(note.Id)" title="Abbrechen" aria-label="Antwort abbrechen">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        </div>
                                                    }

                                                    @if (note.Replies.Count > 0)
                                                    {
                                                        <div class="monitor-note-replies">
                                                            @foreach (var reply in note.Replies.OrderBy(r => r.Timestamp))
                                                            {
                                                                <div class="monitor-reply-thread ps-2 py-1 mb-1">
                                                                    <div class="text-muted">@reply.SourceTeamName · @reply.FormattedTimestamp</div>
                                                                    <div>@MentionTextarea.RenderWithMentions(reply.Text)</div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                    break;

                                case KnownPanels.Wetter:
                                    @if (!string.IsNullOrWhiteSpace(_monitorWeatherError))
                                    {
                                        <div class="monitor-summary-error" role="status">@_monitorWeatherError</div>
                                    }
                                    @if (_monitorWeather is not null)
                                    {
                                        <div class="monitor-weather-summary">
                                            <div class="monitor-weather-reading">
                                                <span class="monitor-weather-label">Temperatur</span>
                                                <div class="monitor-weather-value-row">
                                                    <strong class="monitor-summary-primary-value">@_monitorWeather.Temperatur.ToString("0.0")°C</strong>
                                                    @if (temperatureTrend.IsAvailable)
                                                    {
                                                        <span class="monitor-weather-trend @temperatureTrend.CssClass" title="@temperatureTrend.Description" aria-label="@temperatureTrend.Description">
                                                            <i class="bi @temperatureTrend.IconClass" aria-hidden="true"></i>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="monitor-weather-reading">
                                                <span class="monitor-weather-label">Wind</span>
                                                <div class="monitor-weather-value-row">
                                                    <strong class="monitor-weather-value"><i class="bi bi-wind me-1" aria-hidden="true"></i>@_monitorWeather.Windgeschwindigkeit.ToString("0") km/h</strong>
                                                    @if (windTrend.IsAvailable)
                                                    {
                                                        <span class="monitor-weather-trend @windTrend.CssClass" title="@windTrend.Description" aria-label="@windTrend.Description">
                                                            <i class="bi @windTrend.IconClass" aria-hidden="true"></i>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="monitor-weather-reading">
                                                <span class="monitor-weather-label">Regen</span>
                                                <div class="monitor-weather-value-row">
                                                    <strong class="monitor-weather-value"><i class="bi bi-droplet me-1" aria-hidden="true"></i>@_monitorWeather.Niederschlag.ToString("0.0") mm/h</strong>
                                                    @if (rainTrend.IsAvailable)
                                                    {
                                                        <span class="monitor-weather-trend @rainTrend.CssClass" title="@rainTrend.Description" aria-label="@rainTrend.Description">
                                                            <i class="bi @rainTrend.IconClass" aria-hidden="true"></i>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        @if (_monitorWeather.HatWarnung || dogHeatWarning)
                                        {
                                            <div class="monitor-summary-alerts" role="status">
                                                @if (_monitorWeather.HatWarnung)
                                                {
                                                    <span class="monitor-summary-alert">
                                                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                        DWD: @_monitorWeather.WarnungsStufe
                                                    </span>
                                                }
                                                @if (dogHeatWarning)
                                                {
                                                    <span class="monitor-summary-alert monitor-summary-alert--heat">
                                                        <i class="bi bi-thermometer-high" aria-hidden="true"></i>
                                                        Über 30 °C: Hunde beachten
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @if (_monitorWeatherLoading)
                                        {
                                            <div class="monitor-weather-refreshing" role="status">Wetter wird aktualisiert …</div>
                                        }
                                        <div id="panel-details-@panel.PanelId" class="monitor-summary-details" hidden="@(!_wetterDetailsExpanded)">
                                            @if (_monitorWeather.Windboeen > 0)
                                            {
                                                <div class="small text-muted"><i class="bi bi-wind me-1" aria-hidden="true"></i>Böen: @_monitorWeather.Windboeen.ToString("0") km/h</div>
                                            }
                                            <div class="small text-muted mt-1">
                                                DWD &bull; @_monitorWeatherLoadedAtLocal.ToString("HH:mm") Uhr
                                                @if (_monitorWeatherUsingFallback)
                                                {
                                                    <span class="text-warning ms-1">(Fallback)</span>
                                                }
                                            </div>
                                            @if (forecastItems.Count > 0)
                                            {
                                                <div class="forecast-strip mt-2" aria-label="Wettervorhersage für die nächsten Stunden">
                                                    @foreach (var item in forecastItems)
                                                    {
                                                        <div class="forecast-item @(item.Temperatur > 30 ? "forecast-heat-warning" : "")">
                                                            <div class="small fw-bold">@Ortszeit.AusUtc(item.Zeitpunkt).ToString("HH:mm")</div>
                                                            <div class="small">@item.Temperatur.ToString("0")°</div>
                                                            <div class="small text-muted"><i class="bi bi-wind" aria-hidden="true"></i> @item.Windgeschwindigkeit.ToString("0")</div>
                                                            <div class="small text-muted"><i class="bi bi-droplet" aria-hidden="true"></i> @item.Niederschlag.ToString("0.0")</div>
                                                            @if (item.Temperatur > 30)
                                                            {
                                                                <div class="small fw-semibold">Hunde: Hitze</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (_monitorWeatherLoading)
                                    {
                                        <div class="monitor-summary-empty" role="status"><i class="bi bi-cloud me-1" aria-hidden="true"></i>Wetterdaten werden geladen …</div>
                                    }
                                    else
                                    {
                                        <div class="monitor-summary-empty"><i class="bi bi-cloud me-1" aria-hidden="true"></i>ELW-Position für Wetter setzen</div>
                                    }
                                    break;

                                case KnownPanels.Suchgebiete:
                                    @if (EinsatzService.CurrentEinsatz.SearchAreas.Count == 0)
                                    {
                                        <div class="text-muted small"><i class="bi bi-map me-1"></i>Noch keine Suchgebiete auf der Karte angelegt.</div>
                                    }
                                    else
                                    {
                                        <div class="suchgebiete-list">
                                            @foreach (var area in EinsatzService.CurrentEinsatz.SearchAreas.OrderBy(a => a.Name))
                                            {
                                                var areaTeam = EinsatzService.Teams.FirstOrDefault(t => t.SearchAreaId == area.Id);
                                                <div class="suchgebiet-row @(area.IsCompleted ? "suchgebiet-done" : "")">
                                                    <span class="suchgebiet-color-dot" style="background:@area.Color"></span>
                                                    <div class="suchgebiet-info">
                                                        <div class="suchgebiet-name">@area.Name</div>
                                                        <div class="suchgebiet-area">@area.FormattedArea</div>
                                                    </div>
                                                    <div class="suchgebiet-team ms-auto">
                                                        @if (areaTeam is not null)
                                                        {
                                                            <span class="suchgebiet-team-name">
                                                                <span class="suchgebiet-team-dot" style="background:@GetTeamColor(areaTeam)" aria-hidden="true"></span>
                                                                @areaTeam.TeamName
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="suchgebiet-unoccupied">Unbesetzt</span>
                                                        }
                                                        @if (area.IsCompleted)
                                                        {
                                                            <span class="suchgebiet-completed" role="img" title="Abgeschlossen" aria-label="Abgeschlossen">
                                                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    break;

                                case KnownPanels.Vermissten:
                                    {
                                        var vermissteList = EinsatzService.CurrentEinsatz.Vermisste ?? new();
                                        var allowMulti = EinsatzService.CurrentEinsatz.Szenario.AllowsMultipleVermisste();
                                        VermisstenInfo? activeVi = null;
                                        if (vermissteList.Count > 0)
                                        {
                                            activeVi = (_vermisstenPanelSelectedId.HasValue
                                                ? vermissteList.FirstOrDefault(v => v.Id == _vermisstenPanelSelectedId.Value)
                                                : null) ?? vermissteList[0];
                                        }
                                    @if (vermissteList.Count == 0)
                                    {
                                        <div class="monitor-summary-empty">
                                            <span><i class="bi bi-person-exclamation me-1" aria-hidden="true"></i>Keine Vermissteninfo erfasst</span>
                                        </div>
                                    }
                                    else
                                    {
                                        var _vi = activeVi!;
                                        @if (vermissteList.Count > 1 || allowMulti)
                                        {
                                            <div class="vermissten-panel-tabs monitor-summary-person-tabs" role="group" aria-label="Vermisste Person auswählen">
                                                @for (var i = 0; i < vermissteList.Count; i++)
                                                {
                                                    var p = vermissteList[i];
                                                    var idx = i + 1;
                                                    var isActive = p.Id == _vi.Id;
                                                    <button class="vermissten-panel-tab @(isActive ? "active" : "")"
                                                            type="button"
                                                            aria-pressed="@isActive"
                                                            @onclick="() => _vermisstenPanelSelectedId = p.Id"
                                                            title="@p.VollerName">
                                                        <span>@idx</span>
                                                    </button>
                                                }
                                                @if (allowMulti)
                                                {
                                                    <button class="vermissten-panel-tab vermissten-panel-tab-add" type="button"
                                                            @onclick="OpenVermisstenModalNew" title="Weitere Person erfassen">
                                                        <i class="bi bi-plus-lg"></i>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        <div class="monitor-summary-person">
                                            <div class="monitor-summary-person-main">
                                                <strong class="monitor-summary-primary-value" title="@_vi.VollerName">@_vi.VollerName</strong>
                                                <span class="monitor-summary-person-meta">
                                                    @(string.IsNullOrWhiteSpace(_vi.Alter) ? "Alter unbekannt" : $"{_vi.Alter} Jahre")
                                                    <span aria-hidden="true">·</span>
                                                    @_vi.Mobilitaet
                                                </span>
                                            </div>
                                            @if (_vi.Suizidrisiko == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja || _vi.Bewaffnet == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja)
                                            {
                                                <div class="monitor-summary-alerts" aria-label="Gefahrenhinweise">
                                                    @if (_vi.Suizidrisiko == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja)
                                                    {
                                                        <span class="monitor-summary-alert">
                                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>Suizidrisiko
                                                        </span>
                                                    }
                                                    @if (_vi.Bewaffnet == Einsatzueberwachung.Domain.Models.RisikoStatus.Ja)
                                                    {
                                                        <span class="monitor-summary-alert">
                                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>Bewaffnet
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="monitor-summary-key-details">
                                            <div class="monitor-summary-key-detail">
                                                <span class="monitor-summary-key-label">Vorerkrankungen</span>
                                                <span class="monitor-summary-key-value">@(string.IsNullOrWhiteSpace(_vi.Vorerkrankungen) ? "Nicht angegeben" : _vi.Vorerkrankungen)</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(_vi.Medikamente))
                                            {
                                                <div class="monitor-summary-key-detail">
                                                    <span class="monitor-summary-key-label">Medikamente</span>
                                                    <span class="monitor-summary-key-value">@_vi.Medikamente</span>
                                                </div>
                                            }
                                        </div>
                                        <div id="panel-details-@panel.PanelId" class="monitor-summary-details" hidden="@(!_vermisstenDetailsExpanded)">
                                            @if (_vermisstenDetailsExpanded)
                                            {
                                                <div class="row g-2 small mt-1">
                                                    @if (!string.IsNullOrWhiteSpace(_vi.Kleidung))
                                                    {
                                                        <div class="col-12">
                                                            <div class="vermissten-field-label">Kleidung</div>
                                                            <div class="vermissten-field-value">@_vi.Kleidung</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(_vi.ZuletztGesehenOrt))
                                                    {
                                                        <div class="col-8">
                                                            <div class="vermissten-field-label">Zuletzt gesehen (Ort)</div>
                                                            <div class="vermissten-field-value">@_vi.ZuletztGesehenOrt</div>
                                                        </div>
                                                        <div class="col-4">
                                                            <div class="vermissten-field-label">Uhrzeit</div>
                                                            <div class="vermissten-field-value">@_vi.ZuletztGesehenZeit</div>
                                                        </div>
                                                    }
                                                    @if (_vi.ZuletztAktualisiert.HasValue)
                                                    {
                                                        <div class="col-12">
                                                            <div class="text-muted monitor-timestamp-small">Stand: @_vi.ZuletztAktualisiert.Value.ToString("dd.MM. HH:mm")</div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                    }
                    break;
                        }
                    </div>
                </section>
            </div>
        }
    </main>
    }
</div>

    @if (_showCollarSelectModal)
    {
        var collarSelectTeam = _collarSelectTeamId != null
            ? EinsatzService.Teams.FirstOrDefault(t => t.TeamId == _collarSelectTeamId)
            : null;
        <div class="modal-overlay">
            <button type="button" class="modal-overlay-dismiss" @onclick="CollarSelectCancel" aria-label="Dialog schließen"></button>
            <div class="modal-modern modal-modern--sm" @onclick:stopPropagation="true">
                <div class="modal-modern-header">
                    <h4 class="mb-0"><i class="bi bi-broadcast me-2"></i>GPS-Halsband zuweisen</h4>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CollarSelectCancel">×</button>
                </div>
                <div class="modal-modern-body">
                    <p class="text-muted small mb-3">
                        Team <strong>@(collarSelectTeam?.TeamName ?? "?")</strong> hat noch kein Halsband.
                        Bitte jetzt zuweisen oder ohne Halsband starten.
                    </p>
                    <label class="form-label">GPS-Halsband</label>
                    <select class="form-select mb-0" @bind="_collarSelectCollarId">
